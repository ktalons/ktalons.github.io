{{- $.Scratch.Add "index" slice -}}
{{- range where .Site.RegularPages "Type" "in"  (slice "posts" "blog" "projects") -}}
    {{- $.Scratch.Add "index" (dict "title" .Title "date" .Date "tags" .Params.tags "categories" .Params.categories "content"  .Plain "permalink" .Permalink "summary" .Summary) -}}
{{- end -}}
{{- $.Scratch.Get "index" | jsonify -}}
