{{/*
  Blog section RSS feed.

  This is Hugo's internal _default/rss.xml copied verbatim, with two lines changed
  so the feed reads "Talons Dev Blog Feed" instead of Hugo's default
  "<Section> on <Site.Title>" construction. Scoped to layouts/blog/ so only
  /blog/index.xml is affected — the home feed and any taxonomy feeds still use
  Hugo's internal template.

  Because it's a copy, it does NOT track upstream changes to Hugo's internal
  template. Re-extract it after a major Hugo upgrade if feed output drifts.
*/}}
{{- $feedTitle := "Talons Dev Blog Feed" }}
{{- $feedDescription := "Recent posts on Talons Dev Blog" }}

{{- $authorEmail := "" }}
{{- with site.Params.author }}
	{{- if reflect.IsMap . }}
		{{- with .email }}
			{{- $authorEmail = . }}
		{{- end }}
	{{- end }}
{{- end }}

{{- $authorName := "" }}
{{- with site.Params.author }}
	{{- if reflect.IsMap . }}
		{{- with .name }}
			{{- $authorName = . }}
		{{- end }}
	{{- else }}
		{{- $authorName = . }}
	{{- end }}
{{- end }}

{{- $pctx := . }}
{{- if .IsHome }}{{ $pctx = .Site }}{{ end }}
{{- $pages := slice }}
{{- if or $.IsHome $.IsSection }}
	{{- $pages = $pctx.RegularPages }}
{{- else }}
	{{- $pages = $pctx.Pages }}
{{- end }}
{{- $limit := .Site.Config.Services.RSS.Limit }}
{{- if ge $limit 1 }}
	{{- $pages = $pages | first $limit }}
{{- end }}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
	<channel>
		<title>{{ $feedTitle }}</title>
		<link>{{ .Permalink }}</link>
		<description>{{ $feedDescription }}</description>
		<generator>Hugo</generator>
		<language>{{ site.Language.Locale }}</language>
		{{ with $authorEmail }}
			<managingEditor>{{ . }}{{ with $authorName }} ({{ . }}){{ end }}</managingEditor>
		{{ end }}
		{{ with $authorEmail }}
			<webMaster>{{ . }}{{ with $authorName }} ({{ . }}){{ end }}</webMaster>
		{{ end }}
		{{ with .Site.Copyright }}
			<copyright>{{ . }}</copyright>
		{{ end }}
		{{ if not .Date.IsZero }}
			<lastBuildDate>{{ (index $pages.ByLastmod.Reverse 0).Lastmod.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
		{{ end }}
		{{- with .OutputFormats.Get "RSS" }}
			{{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
		{{- end }}
		{{- range $pages }}
			<item>
				<title>{{ .Title }}</title>
				<link>{{ .Permalink }}</link>
				<pubDate>{{ .PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
				{{- with $authorEmail }}<author>{{ . }}{{ with $authorName }} ({{ . }}){{ end }}</author>{{ end }}
				<guid>{{ .Permalink }}</guid>
				<description>{{ .Summary | transform.XMLEscape | safeHTML }}</description>
			</item>
		{{- end }}
	</channel>
</rss>
